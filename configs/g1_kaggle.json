{
  "registry": "configs/datasets.json",
  "prepared_dir": "data/prepared/g1_vla_v1",
  "output_dir": "outputs/g1_smolvla_full",
  "action_convention": "g1_sonic_v1_1_latent64",
  "backend": "smolvla",
  "device": "cuda",
  "training_engine": "ddp_amp_v2",
  "precision": "fp16",
  "eval_precision": "fp16",
  "num_gpus": 2,
  "seed": 42,
  "steps": 5000,
  "batch_size": 1,
  "gradient_accumulation": 8,
  "lr": 0.0001,
  "weight_decay": 0.0001,
  "warmup_steps": 250,
  "eval_every": 500,
  "validation_max_samples": 128,
  "num_workers": 2,
  "eval_num_workers": 0,
  "prefetch_factor": 2,
  "cpu_threads_per_rank": 2,
  "cache_episodes": 4,
  "packed_cache": true,
  "fused_optimizer": true,
  "ddp_find_unused_parameters": false,
  "amp_init_scale": 1024,
  "grad_clip_norm": 1.0,
  "velocity_weight": 0.01,
  "smolvla_revision_key": "smolvla"
}
