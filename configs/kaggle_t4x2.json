{
  "registry": "configs/datasets.json",
  "datasets": ["libero_object", "libero_spatial"],
  "raw_dir": "data/raw",
  "prepared_dir": "data/prepared/kaggle_t4x2",
  "episodes_per_task": 10,
  "image_size": 256,
  "stride": 3,
  "horizon": 50,
  "seed": 42,
  "action_convention": "libero_osc_delta_xyz_axis_angle_gripper_open01",
  "output_dir": "outputs/kaggle_smolvla_t4x2",
  "backend": "smolvla",
  "device": "cuda",
  "training_engine": "ddp_amp_v2",
  "precision": "fp16",
  "eval_precision": "fp16",
  "num_gpus": 2,
  "steps": 5000,
  "batch_size": 1,
  "gradient_accumulation": 8,
  "lr": 0.0001,
  "eval_every": 500,
  "warmup_steps": 250,
  "num_workers": 2,
  "eval_num_workers": 0,
  "prefetch_factor": 2,
  "cpu_threads_per_rank": 2,
  "cache_episodes": 8,
  "packed_cache": true,
  "fused_optimizer": true,
  "ddp_find_unused_parameters": false,
  "amp_init_scale": 1024,
  "grad_clip_norm": 1.0,
  "validation_max_samples": 64,
  "smolvla_revision_key": "smolvla"
}
