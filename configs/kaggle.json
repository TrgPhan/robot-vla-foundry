{
  "registry": "configs/datasets.json",
  "datasets": ["libero_object", "libero_spatial"],
  "raw_dir": "data/raw",
  "prepared_dir": "data/prepared/kaggle",
  "episodes_per_task": 10,
  "image_size": 256,
  "stride": 3,
  "horizon": 50,
  "seed": 42,
  "action_convention": "libero_osc_delta_xyz_axis_angle_gripper_open01",
  "output_dir": "outputs/kaggle_smolvla",
  "backend": "smolvla",
  "device": "cuda",
  "steps": 5000,
  "batch_size": 1,
  "gradient_accumulation": 16,
  "lr": 0.0001,
  "eval_every": 500,
  "warmup_steps": 250,
  "num_workers": 0,
  "cache_episodes": 2,
  "validation_max_batches": 32,
  "smolvla_model": "lerobot/smolvla_base",
  "smolvla_revision_key": "smolvla"
}

